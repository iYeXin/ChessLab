<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The app UI is always light (cream), so force
         the light theme regardless of system dark mode, and render system
         bar icons dark for contrast on the light background. -->
    <style name="Theme.chessnext" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
