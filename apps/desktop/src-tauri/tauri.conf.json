{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChessNext",
  "version": "0.4.0-alpha",
  "identifier": "com.chessnext.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChessNext 中国象棋",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../engines"
    ]
  }
}
