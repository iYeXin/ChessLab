{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChessLab",
  "version": "0.3.2",
  "identifier": "com.chesslab.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChessLab 棋弈",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["../engines"]
  }
}
