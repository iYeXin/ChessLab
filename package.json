{
  "name": "chesslab",
  "private": true,
  "version": "0.3.3",
  "description": "Cross-platform chess & xiangqi app (React Native: Android + Windows)",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:engines": "tsx scripts/smoke-engines.ts",
    "fetch:engines": "powershell -ExecutionPolicy Bypass -File scripts/fetch-engines.ps1",
    "sync:jniLibs": "powershell -ExecutionPolicy Bypass -File scripts/sync-android-engines.ps1",
    "build": "node build.js",
    "build:windows": "node build.js --windows",
    "build:android": "node build.js --android",
    "android": "pnpm --filter chessapp android",
    "windows": "pnpm --filter chessapp windows",
    "start": "pnpm --filter chessapp start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
