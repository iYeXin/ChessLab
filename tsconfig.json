{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@chesslab/rules-core": ["./packages/rules-core/src/index.ts"],
      "@chesslab/rules-chess": ["./packages/rules-chess/src/index.ts"],
      "@chesslab/rules-xiangqi": ["./packages/rules-xiangqi/src/index.ts"],
      "@chesslab/engine-uci": ["./packages/engine-uci/src/index.ts"],
      "@chesslab/engine-process": ["./packages/engine-process/src/index.ts"],
      "@chesslab/game-session": ["./packages/game-session/src/index.ts"],
      "@chesslab/persistence": ["./packages/persistence/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/vendor/*.d.ts",
    "packages/*/__tests__/**/*.test.ts",
    "scripts/**/*.ts"
  ]
}
