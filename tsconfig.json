{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@chessnext/rules-core": ["./packages/rules-core/src/index.ts"],
      "@chessnext/rules-xiangqi": ["./packages/rules-xiangqi/src/index.ts"],
      "@chessnext/engine-uci": ["./packages/engine-uci/src/index.ts"],
      "@chessnext/game-session": ["./packages/game-session/src/index.ts"],
      "@chessnext/engine-onnx": ["./packages/engine-onnx/src/index.ts"],
      "@chessnext/persistence": ["./packages/persistence/src/index.ts"],
      "@chessnext/puzzles": ["./packages/puzzles/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/vendor/*.d.ts",
    "packages/*/__tests__/**/*.test.ts",
    "scripts/**/*.ts"
  ]
}
